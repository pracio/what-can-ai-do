---
// Root path: language negotiation. Static site, so the redirect happens client-side;
// <noscript> keeps the site usable without JS and gives crawlers a zh-Hans entry.
const B = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
---
<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>What Can AI Do?</title>
    <meta name="description" content="What Can AI Do? — free walkthroughs of what today's AI can actually do, in Simplified Chinese, Traditional Chinese, and English." />
    <meta property="og:title" content="What Can AI Do?" />
    <meta property="og:site_name" content="What Can AI Do?" />
    <link rel="canonical" href={`${B}/zh-Hans/`} />
    <link rel="alternate" hreflang="zh-Hans" href={`${B}/zh-Hans/`} />
    <link rel="alternate" hreflang="zh-Hant" href={`${B}/zh-Hant/`} />
    <link rel="alternate" hreflang="en" href={`${B}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${B}/zh-Hans/`} />
    <meta http-equiv="refresh" content="0;url=/zh-Hans/" />
    <script is:inline>
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('wcad-lang'); } catch (e) {}
        var nav = (navigator.language || 'zh-Hans').toLowerCase();
        var dest;
        if (saved) {
          dest = saved;
        } else if (nav.indexOf('zh') === 0) {
          // zh-tw/zh-hk/zh-hant → Traditional; other zh → Simplified
          dest = (nav.indexOf('tw') > 0 || nav.indexOf('hk') > 0 || nav.indexOf('hant') > 0 || nav.indexOf('mo') > 0) ? '/zh-Hant/' : '/zh-Hans/';
        } else {
          dest = '/en/';
        }
        window.location.replace(dest);
      })();
    </script>
    <style>
      body { font-family: system-ui, sans-serif; display: grid; place-items: center; min-height: 100vh; margin: 0; color: #333; background: #f7f7fa; }
      a { color: #555; }
    </style>
    <meta property="og:image" content="https://what-can-ai-do.pages.dev/og-card.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://what-can-ai-do.pages.dev/og-card.jpg" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>
  <body>
    <noscript><meta http-equiv="refresh" content="0;url=/zh-Hans/" /><p><a href="/zh-Hans/">What Can AI Do?</a> · <a href="/zh-Hant/">繁體</a> · <a href="/en/">English</a></p></noscript>
    <p><a href="/zh-Hans/">中文</a> · <a href="/zh-Hant/">繁體</a> · <a href="/en/">English</a></p>
  </body>
</html>
