---
import { getCollection } from 'astro:content';
import TaskPage from '../../../components/TaskPage.astro';

export async function getStaticPaths() {
  const tasks = await getCollection('tasksZhHant');
  const ordered = [...tasks].sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99) || a.id.localeCompare(b.id));
  return ordered.map((task, i) => ({
    params: { slug: task.id.replace(/\.md$/, '') },
    props: {
      task,
      prev: i > 0 ? ordered[i - 1] : ordered[ordered.length - 1],
      next: i < ordered.length - 1 ? ordered[i + 1] : ordered[0],
    },
  }));
}

const { task, prev, next } = Astro.props;
const B = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const ui = {
  backLabel: '← 回到所有案例',
  homeHref: `${B}/zh-Hant/`,
  themeBtn: '☀︎/☾ 切換',
  themeAria: '切換亮色暗色',
  footnote: '指數說明：一句話指數=你要對 AI 說多少話才能達到理想效果；折騰指數=架環境要裝多少東西；風險指數=搞砸了有多大代價。',
  lastTested: '最後實測：',
  pendingBadge: '路徑待真機驗證',
  shareLabel: '分享給需要的人',
  shareOk: '已複製連結 ✓',
  promptCopyHint: '點一下複製',
  promptCopyOk: '已複製，去貼上 ✓',
  troubleshootTitle: '沒成功？看這裡',
  troubleshootLead: '大部分失敗是這四個原因：',
  troubleshootItems: [
    "AI 沒反應或一直轉圈：等一會兒再試，或把 App 滑掉重開",
    "認不出圖片：確認照片真的傳出去了（對話框裡看得到縮圖）",
    "效果太差：換張更清楚的照片，或按教學裡的追問句式再傳一句",
    "提示次數用完：教學裡通常有備選工具，換一個免費的",
  ],
  riskBar: '提醒：內容會傳給 AI 的伺服器。身分證、銀行卡、密碼，永遠不要傳。',
  prevLabel: '← 上一個案例',
  nextLabel: '下一個案例 →',
  htmlLang: 'zh-Hant',
  toolsLabel: '用哪個 AI：',
};
---
<TaskPage task={task} ui={ui} prev={prev} next={next} />
