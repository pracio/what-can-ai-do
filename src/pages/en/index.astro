---
import { TASK_ICONS } from '../../icons/task-icons';
import { getCollection } from 'astro:content';

const tasks = (await getCollection('tasksEn')).sort((a, b) => a.id.localeCompare(b.id));

// 每case: SVG图标 + accent色 + 三步速览(看一眼就知道怎么做) + 单行指数



const B = import.meta.env.BASE_URL.replace(/\/$/, ''); // '/wcad' 或 ''(base='/'时BASE_URL='/'须去尾, 否则${B}/x 变 //x 协议相对URL)
const TOOL_HTML = {
  chatgpt: `<a class="tool-ic" href="https://chatgpt.com/" target="_blank" rel="noopener" aria-label="ChatGPT" data-tip="ChatGPT · OpenAI"><img src="${B}/icons/chatgpt.svg" alt="" width="18" height="18" /></a>`,
  gemini: `<a class="tool-ic" href="https://gemini.google.com/" target="_blank" rel="noopener" aria-label="Gemini" data-tip="Gemini · Google"><img src="${B}/icons/gemini.svg" alt="" width="18" height="18" /></a>`,
};

const cards = tasks
  .filter(t => t.data.order != null)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map(t => {
    const d = t.data;
    return {
      slug: t.id.replace(/\.md$/, ''),
      title: d.title ?? d.task_id,
      tagline: d.tagline ?? '',
      icon: TASK_ICONS[d.icon ?? ''] ?? '',
      accent: d.accent ?? '#8b5cf6',
      accent2: d.accent2 ?? '#c4b5fd',
      steps: d.steps ?? [],
      indices: {
        prompt: d.indices.prompt, promptText: d.indicesText?.prompt ?? '',
        hassle: d.indices.hassle, hassleText: d.indicesText?.hassle ?? '',
        risk: d.indices.risk, riskText: d.indicesText?.risk ?? '',
      },
      riskRaw: d.indices.risk,
    };
  });
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>What Can AI Do? — real answers for regular people</title>
    <meta name="description" content="20 real-life situations where free AI actually helps: restore old photos, digest long documents, tutor your kid, spot scams. One copy-paste prompt per case." />
    <link rel="canonical" href="https://what-can-ai-do.pages.dev/en/" />
    <link rel="alternate" hreflang="zh-Hans" href="https://what-can-ai-do.pages.dev/zh-Hans/" />
    <link rel="alternate" hreflang="zh-Hant" href="https://what-can-ai-do.pages.dev/zh-Hant/" />
    <link rel="alternate" hreflang="en" href="https://what-can-ai-do.pages.dev/en/" />
    <link rel="alternate" hreflang="x-default" href="https://what-can-ai-do.pages.dev/zh-Hans/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="What Can AI Do? — real answers for regular people" />
    <meta property="og:description" content="20 real-life situations where free AI actually helps: restore old photos, digest long documents, tutor your kid, spot scams. One copy-paste prompt per case." />
    <meta property="og:url" content="https://what-can-ai-do.pages.dev/en/" />
    <meta property="og:site_name" content="What Can AI Do?" />
    <meta name="twitter:card" content="summary" />
  <script is:inline>
    (function () {
      var saved = localStorage.getItem('wcad-theme');
      var sys = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      document.documentElement.dataset.theme = saved || sys;
    })();
  </script>
  <style>
    :root {
      --bg: #08080c; --ink: #fff;
      --glass: rgba(255,255,255,.055); --glass-strong: rgba(255,255,255,.10);
      --glass-border: rgba(255,255,255,.12); --glass-border-soft: rgba(255,255,255,.08);
      --ink-92: rgba(255,255,255,.92); --ink-75: rgba(255,255,255,.75); --ink-55: rgba(255,255,255,.55); --ink-45: rgba(255,255,255,.45); --ink-40: rgba(255,255,255,.40); --ink-38: rgba(255,255,255,.38);
      --meter-off: rgba(255,255,255,.12); --quote-bg: rgba(255,255,255,.03); --quote-bg-hover: rgba(255,255,255,.04);
      --tip-bg: #1c1c26; --step-n-ink: #0a0a0f;
    }
    [data-theme="light"] {
      --bg: #f2f2f6; --ink: #16161d;
      --glass: rgba(255,255,255,.66); --glass-strong: rgba(255,255,255,.85);
      --glass-border: rgba(22,22,29,.12); --glass-border-soft: rgba(22,22,29,.08);
      --ink-92: rgba(22,22,29,.92); --ink-75: rgba(22,22,29,.75); --ink-55: rgba(22,22,29,.55); --ink-45: rgba(22,22,29,.45); --ink-40: rgba(22,22,29,.42); --ink-38: rgba(22,22,29,.40);
      --meter-off: rgba(22,22,29,.12); --quote-bg: rgba(255,255,255,.5); --quote-bg-hover: rgba(255,255,255,.75);
      --tip-bg: #26262f; --step-n-ink: #fff;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { height: 100%; overflow: hidden; overscroll-behavior: none; }
    body {
      font-family: -apple-system, system-ui, 'PingFang SC', 'Microsoft YaHei', sans-serif;
      background: var(--bg); color: var(--ink); transition: background .3s, color .3s;
    }

    .deck { position: fixed; inset: 0; perspective: 1200px; }
    .slide {
      position: absolute; inset: 0; overflow: hidden;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: max(24px, 6vh) 22px calc(96px + env(safe-area-inset-bottom));
      text-align: center;
      visibility: hidden;
      will-change: transform, opacity;
      transition: transform 0.6s cubic-bezier(0.19, 1, 0.22, 1), opacity 0.6s cubic-bezier(0.19, 1, 0.22, 1), visibility 0s linear 0.6s;
      transform-style: preserve-3d;
    }
    .slide.active { visibility: visible; transform: translateX(0); opacity: 1; z-index: 2; transition-delay: 0s; }
    .slide.prev { visibility: visible; transform: translateX(-38%) scale(0.88); opacity: 0; }
    .slide.next { visibility: visible; transform: translateX(38%) scale(0.88); opacity: 0; }
    .deck.dragging .slide { transition: none; }

    .glow {
      position: absolute; width: 150vmax; height: 150vmax; border-radius: 50%;
      filter: blur(90px); opacity: 0.18; pointer-events: none;
      transform: translate(-50%, -50%); left: 50%; top: 34%;
      transition: opacity 0.6s;
      background: radial-gradient(circle, var(--accent), var(--accent2) 40%, transparent 65%);
    }
    .slide:not(.active) .glow { opacity: 0.04; }

    /* 图标: 缩小为标题旁的点缀 */
    .icon-wrap {
      position: relative; width: clamp(60px, 15vw, 88px); height: clamp(60px, 15vw, 88px);
      display: flex; align-items: center; justify-content: center;
      border-radius: 30%;
      background: linear-gradient(145deg, var(--glass-strong), var(--glass));
      border: 1px solid var(--glass-border);
      box-shadow:
        0 16px 48px rgba(0,0,0,.45),
        inset 0 1px 0 var(--glass-border-soft),
        0 0 56px color-mix(in srgb, var(--accent) 26%, transparent);
    }
    .icon-wrap::before {
      content: ''; position: absolute; inset: -10px; border-radius: 34%;
      border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
      animation: halo 3.2s ease-in-out infinite;
    }
    @keyframes halo { 0%,100% { transform: scale(1); opacity: .5 } 50% { transform: scale(1.08); opacity: .12 } }
    .icon-wrap svg {
      width: 50%; height: 50%;
      color: var(--accent);
      filter: drop-shadow(0 0 20px color-mix(in srgb, var(--accent) 60%, transparent));
    }
    .slide.active .icon-wrap { animation: pop .7s cubic-bezier(0.19,1,0.22,1) both; }
    @keyframes pop { from { transform: scale(0.5) rotate(-6deg); opacity: 0 } to { transform: scale(1) rotate(0); opacity: 1 } }

    /* hero 第一屏 */
    .hero-inner { text-align: center; }
    .hero-q {
      font-size: clamp(40px, 11vw, 84px); font-weight: 900; letter-spacing: -0.03em; line-height: 1.08;
      background: linear-gradient(120deg, var(--ink) 30%, var(--accent2, #fb7185) 90%);
      -webkit-background-clip: text; background-clip: text; color: transparent;
      margin-bottom: 18px;
    }
    .hero-a { font-size: clamp(16px, 4.4vw, 22px); color: var(--ink-92); font-weight: 600; }
    .hero-hint { margin-top: 14px; font-size: clamp(12.5px, 3.4vw, 15px); color: var(--ink-45); letter-spacing: .04em; }

    .head { display: flex; align-items: center; gap: 18px; text-align: left; margin-bottom: 14px; }
    .title {
      font-size: clamp(26px, 6.8vw, 42px); font-weight: 800; letter-spacing: -0.02em;
      margin: 0; line-height: 1.12;
      background: linear-gradient(120deg, var(--ink) 35%, var(--accent2) 95%);
      -webkit-background-clip: text; background-clip: text; color: transparent;
    }
    .tagline { font-size: clamp(13.5px, 3.4vw, 17px); color: var(--ink-75); margin-top: 5px; }

    /* 核心: 三步速览卡 —— 看一眼就知道怎么做 */
    .steps {
      margin-top: 16px; width: min(440px, 100%);
      background: var(--glass); border: 1px solid var(--glass-border);
      border-radius: 20px; padding: 4px 16px;
      backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
      text-align: left;
      box-shadow: 0 20px 60px rgba(0,0,0,.18), inset 0 1px 0 var(--glass-border-soft);
    }
    .step {
      display: flex; align-items: center; gap: 14px;
      padding: 10px 2px; font-size: clamp(13.5px, 3.5vw, 15.5px); line-height: 1.45;
      color: var(--ink-92);
    }
    .step + .step { border-top: 1px solid var(--glass-border-soft); }
    .step .n {
      flex: none; width: 26px; height: 26px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 13px; font-weight: 700; color: var(--step-n-ink);
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      box-shadow: 0 0 16px color-mix(in srgb, var(--accent) 45%, transparent);
    }
    .step :global(a.web-link) {
      color: var(--accent); font-weight: 600; text-decoration: none;
      border-bottom: 1px dashed color-mix(in srgb, var(--accent) 55%, transparent);
    }
    .step :global(a.tool-ic) {
      display: inline-flex; align-items: center; gap: 5px;
      color: var(--accent); font-weight: 600; text-decoration: none;
      padding: 1px 2px; position: relative;
    }
    .step :global(a.tool-ic img) { border-radius: 5px; display: block; }
    .step :global(a.tool-ic) { vertical-align: -5px; }
    .step :global(a.tool-ic::after) {
      content: attr(data-tip);
      position: absolute; bottom: calc(100% + 8px); left: 50%;
      transform: translateX(-50%) translateY(4px);
      background: var(--tip-bg); color: #fff; font-size: 12px; font-weight: 500;
      padding: 5px 10px; border-radius: 8px; white-space: nowrap;
      border: 1px solid var(--glass-border);
      box-shadow: 0 6px 20px rgba(0,0,0,.35);
      opacity: 0; pointer-events: none;
      transition: opacity .18s ease, transform .18s ease;
      z-index: 5;
    }
    .step :global(a.tool-ic::before) {
      content: ''; position: absolute; bottom: calc(100% + 3px); left: 50%;
      transform: translateX(-50%) translateY(4px) rotate(45deg);
      width: 8px; height: 8px; background: var(--tip-bg);
      border-right: 1px solid var(--glass-border);
      border-bottom: 1px solid var(--glass-border);
      opacity: 0; pointer-events: none;
      transition: opacity .18s ease, transform .18s ease;
      z-index: 5;
    }
    .step :global(a.tool-ic:hover::after),
    .step :global(a.tool-ic:hover::before) {
      opacity: 1; transform: translateX(-50%) translateY(0) ;
    }
    .step :global(a.tool-ic:hover::before) { transform: translateX(-50%) translateY(0) rotate(45deg); }

    /* 指数: 迷你量表 chip */
    .indices-line {
      margin-top: 12px; display: flex; gap: 8px; flex-wrap: wrap; justify-content: center;
    }
    .idx-chip {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 6px 14px; border-radius: 999px;
      background: var(--glass); border: 1px solid var(--glass-border-soft);
      font-size: 12.5px; color: var(--ink-55);
    }
    .idx-chip .meter { display: inline-flex; gap: 3px; }
    .idx-chip .meter i {
      width: 10px; height: 10px; border-radius: 3px;
      background: var(--meter-off);
    }
    .idx-chip .meter i.on { background: var(--accent); box-shadow: 0 0 6px color-mix(in srgb, var(--accent) 60%, transparent); }
    .idx-chip.warn { border-color: rgba(255,122,122,.4); }
    .idx-chip.warn .meter i.on { background: #ff7a7a; box-shadow: 0 0 6px rgba(255,122,122,.6); }
    .idx-chip.warn .idx-text { color: #ff9a9a; }

    .step-row + .step-row { border-top: 1px solid var(--glass-border-soft); }
    .step-row:last-child { border-top: none; }
    .copy-hint { flex: none; font-size: 12px; color: var(--ink-40); margin-left: auto; }
    .prompt-quote {
      display: block; width: calc(100% - 34px); text-align: left;
      margin: 2px 0 8px 34px; padding: 10px 12px; box-sizing: border-box;
      background: color-mix(in srgb, var(--accent) 7%, var(--quote-bg));
      border: 1px dashed color-mix(in srgb, var(--accent) 40%, transparent);
      border-radius: 14px; cursor: pointer;
      color: var(--ink-92); font-size: clamp(12px, 3.2vw, 13.5px); line-height: 1.55;
      position: relative; transition: border-color .2s, background .2s;
      font-family: inherit;
    }
    .prompt-quote:hover { border-color: color-mix(in srgb, var(--accent) 70%, transparent); background: color-mix(in srgb, var(--accent) 12%, var(--quote-bg-hover)); }
    .prompt-quote.copied { border-style: solid; border-color: rgba(74,222,128,.6); background: rgba(74,222,128,.08); }
    
    /* 指数: 压成一行小字 */
    .indices-line {
      margin-top: 18px; font-size: 13px; letter-spacing: .02em;
      color: var(--ink-45); display: flex; gap: 14px; flex-wrap: wrap; justify-content: center;
    }
    .indices-line .warn { color: #ff7a7a; }

    .open {
      margin-top: 16px; display: inline-flex; align-items: center; gap: 10px;
      min-height: 48px; padding: 13px 34px;
      background: linear-gradient(120deg, var(--accent), var(--accent2));
      color: #0a0a0f; font-weight: 700; font-size: 17px;
      padding: 15px 40px; border-radius: 999px; text-decoration: none;
      box-shadow: 0 10px 40px color-mix(in srgb, var(--accent) 50%, transparent);
      transition: transform .15s ease, box-shadow .3s;
      cursor: pointer;
    }
    .open:hover { box-shadow: 0 14px 52px color-mix(in srgb, var(--accent) 65%, transparent); }
    .open:active { transform: scale(0.96); }
    .open:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

    /* 进场 stagger */
    .slide.active .icon-wrap { animation-delay: 0s; }
    .slide.active .head    { animation: rise .5s cubic-bezier(0.19,1,0.22,1) .08s both; }
    
    .slide.active .steps   { animation: rise .5s cubic-bezier(0.19,1,0.22,1) .20s both; }
    .slide.active .indices-line { animation: rise .5s cubic-bezier(0.19,1,0.22,1) .28s both; }
    .slide.active .open    { animation: rise .5s cubic-bezier(0.19,1,0.22,1) .34s both; }
    @keyframes rise { from { transform: translateY(24px); opacity: 0 } to { transform: translateY(0); opacity: 1 } }

    .topbar {
      position: fixed; top: calc(18px + env(safe-area-inset-top)); left: 22px; right: 22px;
      display: flex; justify-content: space-between; align-items: center; z-index: 10;
    }
    .brand { font-size: 13px; font-weight: 700; letter-spacing: .14em; color: var(--ink-55); }
    .counter { font-size: 13px; font-variant-numeric: tabular-nums; color: rgba(255,255,255,.55); letter-spacing: .1em; }
    .counter b { color: var(--accent-live, var(--ink)); font-size: 16px; }
    .top-right { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; }
    .about-link { font-size: 11px; color: var(--ink-45); text-decoration: none; border: 1px solid var(--glass-border); border-radius: 999px; padding: 2px 10px; transition: color .2s, border-color .2s; }
    .about-link:hover, .about-link:active { color: var(--ink-92); border-color: var(--ink-55); }
    .top-links { display: flex; align-items: center; gap: 8px; }
    .theme-btn { border: 1px solid var(--glass-border); background: var(--glass); color: var(--ink-75);
                 border-radius: 999px; padding: 2px 10px; font-size: 11px; cursor: pointer; font-family: inherit; }
    .theme-btn:hover { color: var(--ink); }

    .progress {
      position: fixed; bottom: calc(20px + env(safe-area-inset-bottom)); left: 50%; transform: translateX(-50%);
      display: flex; align-items: center; z-index: 10;
      width: 140px; height: 14px; padding: 0;
    }
    .progress .track {
      width: 100%; height: 3px; border-radius: 999px;
      background: var(--meter-off); overflow: hidden;
    }
    .progress .fill {
      height: 100%; width: 0; border-radius: 999px;
      background: var(--accent-live, var(--ink)); box-shadow: 0 0 8px var(--accent-live, var(--ink));
      transition: width .45s cubic-bezier(0.19,1,0.22,1);
    }


    .hint { position: fixed; bottom: calc(82px + env(safe-area-inset-bottom)); left: 0; right: 0; text-align: center; font-size: 13px; color: var(--ink-38); z-index: 10; animation: fadeout 1s ease 4s both; pointer-events: none; }
    @keyframes fadeout { to { opacity: 0 } }

    .arrow {
      position: fixed; top: 50%; transform: translateY(-50%); z-index: 10;
      width: 48px; height: 48px; border-radius: 50%;
      background: var(--glass); border: 1px solid var(--glass-border);
      color: var(--ink-75); font-size: 20px; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: all .25s; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    }
    .arrow:hover { background: var(--glass-strong); color: var(--ink); }
    .arrow.l { left: 26px; } .arrow.r { right: 26px; }
    @media (hover: none), (max-width: 720px) { .arrow { display: none; } 
      /* portrait overflow guard: EN/zh-Hant titles wrap taller than zh-Hans; keep head and
         the steps card from colliding when content exceeds the slide (large system fonts) */
      .slide { overflow-y: auto; -webkit-overflow-scrolling: touch; }
      .slide::before { content: ''; margin: auto 0; }      /* top spacer keeps centering when short */
      .slide::after  { content: ''; margin: auto 0; }      /* bottom spacer balances flex-start */
      .slide { justify-content: flex-start; }
      .head { flex-shrink: 0; }
      .steps, .indices-line, .open { flex-shrink: 0; }
      .title { font-size: clamp(24px, 6.2vw, 34px); }
      .head { gap: 14px; }
}

    @media (prefers-reduced-motion: reduce) {
      .slide { transition: opacity .2s; transform: none !important; }
      .icon-wrap, .icon-wrap::before,
      .slide.active .head, .slide.active .steps,
      .slide.active .indices-line, .slide.active .open { animation: none !important; opacity: 1; }
    }
  .finale { display: flex; align-items: center; justify-content: center; }
  .finale-box { max-width: 300px; text-align: center; padding: 0 8px; }
  .finale-kicker { font-size: 11px; letter-spacing: .3em; opacity: .5; margin: 0 0 10px; }
  .finale-title { font-size: 34px; margin: 0 0 14px; }
  .finale-text { font-size: 14px; line-height: 1.8; opacity: .8; margin: 0 0 22px; }
  .finale-cta { display: inline-block; margin: 0 0 14px; padding: 12px 22px; border-radius: 999px;
         background: linear-gradient(120deg, #fbbf24, #fb7185); color: #0a0a0f;
         font-weight: 700; text-decoration: none; font-size: 14px; }
  .finale-share { display: block; margin: 0 auto; border: none; background: none; color: inherit;
           opacity: .6; font-size: 12.5px; text-decoration: underline; cursor: pointer; font-family: inherit; }
  </style>
  <meta property="og:image" content="https://what-can-ai-do.pages.dev/og-card.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://what-can-ai-do.pages.dev/og-card.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>
<body>
  <div class="topbar">
    <div class="brand">WHAT CAN AI DO?</div>
    <div class="top-right">
      <div class="counter" id="counter" data-hero="序章">Case <b id="cur">01</b> / {String(cards.length).padStart(2, '0')}</div>
      <div class="top-links">
        <button class="theme-btn" id="theme-btn" aria-label="切换亮色暗色">☀︎/☾</button>
        <a class="about-link" href={`${B}/en/about/`}>About</a>
      </div>
    </div>
  </div>

  <div class="deck" id="deck">
    <section class="slide hero active" data-index="0" style="--accent:#fbbf24;--accent2:#fb7185">
      <div class="glow"></div>
      <div class="hero-inner">
        <p class="hero-q">What Can AI Do?</p>
        <p class="hero-a">20 real answers. Swipe →</p>
        <p class="hero-hint">All free. Copy the prompts and go.</p>
      </div>
    </section>
    {cards.map((c, i) => (
      <section class={`slide`} data-index={i + 1} style={`--accent:${c.accent};--accent2:${c.accent2}`}>
        <div class="glow"></div>
        <div class="head">
          <div class="icon-wrap" set:html={c.icon} />
          <div class="head-text">
            <h1 class="title">{c.title}</h1>
            <p class="tagline">{c.tagline}</p>
          </div>
        </div>
        <div class="steps">
          {c.steps.map(s => (
            <div class="step-row">
              <div class="step">
                <span class="n">{s.n}</span>
                <span set:html={s.text
                  .replace(/\{\{chatgpt\}\}/g, TOOL_HTML.chatgpt)
                  .replace(/\{\{gemini\}\}/g, TOOL_HTML.gemini)} />
                {s.prompt && <span class="copy-hint">Tap to copy ↴</span>}
              </div>
              {s.prompt && (
                <button class="prompt-quote" data-prompt={s.prompt} aria-label="Tap to copy this prompt">
                  <span class="q">“{s.prompt}”</span>
                </button>
              )}
            </div>
          ))}
        </div>
        <div class="indices-line">
          {(['prompt', 'hassle', 'risk'] as const).map(k => (
            <span class={`idx-chip ${k === 'risk' && c.riskRaw >= 4 ? 'warn' : ''}`}>
              <span class="meter" aria-hidden="true">
                {[1,2,3,4,5].map(n => <i class={n <= c.indices[k] ? 'on' : ''} />)}
              </span>
              <span class="idx-text">{c.indices[k + 'Text']}</span>
            </span>
          ))}
        </div>
        <a class="open" href={`${B}/en/tasks/${c.slug}/`}>Full guide <span aria-hidden="true">→</span></a>
      </section>
    ))}

      <section class="slide finale" data-finale style="--accent:#fbbf24;--accent2:#fb7185">
        <div class="glow"></div>
        <div class="finale-box">
          <p class="finale-kicker">That's all 20</p>
          <h1 class="finale-title">Your turn</h1>
          <p class="finale-text">Pick one case and try it on your phone today. Made it work? Tell us — your case goes up and helps the next person.</p>
          <a class="finale-cta" href="https://github.com/pracio/what-can-ai-do/issues" target="_blank" rel="noopener">Submit your case →</a>
          <button class="finale-share" id="finale-share">Send this to the person who says "isn't AI just for chatting?"</button>
        </div>
      </section>
  </div>

  <button class="arrow l" id="prev" aria-label="上一个">←</button>
  <button class="arrow r" id="next" aria-label="下一个">→</button>
  <div class="progress" aria-label="Case progress"><div class="track"><div class="fill" id="fill"></div></div></div>
  <div class="hint">Swipe to browse</div>

  <script>
    const deck = document.getElementById('deck') as HTMLElement;
    const slides = Array.from(deck.querySelectorAll('.slide')) as HTMLElement[];
    const fill = document.getElementById('fill') as HTMLElement;
    const counter = document.getElementById('cur') as HTMLElement;
    let cur = 0;

    function render() {
      const isHero = cur === 0;
      const accent = slides[cur].style.getPropertyValue('--accent');
      document.documentElement.style.setProperty('--accent-live', accent);
      // hero不计入案例号: hero时案例号显示 00, 进度条按 (cur)/(total-1) 起步为0
      counter.textContent = String(Math.min(cur, slides.length - 2)).padStart(2, '0');
      document.getElementById('counter').style.opacity = isHero ? '.45' : '';
      slides.forEach((s, i) => {
        s.style.transform = ''; s.style.opacity = ''; s.style.visibility = '';
        s.className = 'slide ' + (i === cur ? 'active' : i < cur ? 'prev' : 'next');
      });
      fill.style.width = (cur / (slides.length - 1) * 100).toFixed(1) + '%';
    }

    (window as any).__wcadGo = go;
    // 末屏分享
    var fs = document.getElementById('finale-share');
    if (fs) fs.addEventListener('click', function () {
      var url = location.origin + '/';  // 根链接: 对方浏览器自动语言协商
      if (navigator.share) { navigator.share({ title: document.title, url: url }).catch(function(){}); }
      else if (navigator.clipboard) { navigator.clipboard.writeText(url).then(function(){ var t = fs.textContent; fs.textContent = 'Copied ✓'; setTimeout(function(){ fs.textContent = t; }, 1800); }); }
    });
 // 测试/调试钩子
    function go(i: number) {
      cur = Math.max(0, Math.min(slides.length - 1, i));
      render();
    }

    // 触摸滑动（跟手 + 3D 微倾斜）— 支持横向和纵向
    let startX = 0, startY = 0, dx = 0, dy = 0, dragging = false, axis: 'x' | 'y' | null = null;
    deck.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX; startY = e.touches[0].clientY;
      dx = 0; dy = 0; dragging = true; axis = null;
    }, { passive: true });
    deck.addEventListener('touchmove', (e) => {
      if (!dragging) return;
      const x = e.touches[0].clientX, y = e.touches[0].clientY;
      if (!axis && (Math.abs(x - startX) > 10 || Math.abs(y - startY) > 10)) {
        axis = Math.abs(x - startX) > Math.abs(y - startY) ? 'x' : 'y';
        deck.classList.add('dragging');
      }
      if (axis) {
        dx = x - startX; dy = y - startY;
        const ratio = axis === 'x' ? dx / window.innerWidth : dy / window.innerHeight;
        slides.forEach((s, i) => {
          const off = (i - cur) * 100 + ratio * 100;
          s.style.visibility = Math.abs(off) < 100 ? 'visible' : 'hidden';
          const tilt = i === cur ? ratio * -6 : 0;
          const scale = i === cur ? Math.max(0.86, 1 - Math.abs(ratio) * 0.14) : 0.88;
          const tx = axis === 'x' ? off : 0;
          const ty = axis === 'y' ? off : 0;
          s.style.transform = `translate(${tx}%, ${ty}%) rotateY(${axis === 'x' ? tilt : 0}deg) rotateX(${axis === 'y' ? -tilt : 0}deg) scale(${scale})`;
          s.style.opacity = String(Math.max(0, 1 - Math.abs(off) / 55));
        });
      }
    }, { passive: true });
    deck.addEventListener('touchend', () => {
      if (axis) {
        deck.classList.remove('dragging');
        const d = axis === 'x' ? dx : dy;
        if (d < -60) go(cur + 1); else if (d > 60) go(cur - 1); else render();
      }
      dragging = false; axis = null; dx = 0; dy = 0;
    });

    // 复制提示词
    deck.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('.prompt-quote') as HTMLButtonElement | null;
      if (!btn) return;
      try {
        await navigator.clipboard.writeText(btn.dataset.prompt || '');
      } catch {
        const ta = document.createElement('textarea');
        ta.value = btn.dataset.prompt || '';
        document.body.appendChild(ta); ta.select();
        document.execCommand('copy'); ta.remove();
      }
      btn.classList.add('copied');
      const row = btn.closest('.step-row') as HTMLElement | null;
      const hint = row ? row.querySelector('.copy-hint') : null;
      const orig = hint ? hint.textContent : null;
      if (hint) hint.textContent = 'Copied ✓';
      setTimeout(() => {
        btn.classList.remove('copied');
        if (hint && orig) hint.textContent = orig;
      }, 1800);
    });

    // 键盘 & 滚轮 & 桌面箭头
    window.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === ' ') { e.preventDefault(); go(cur + 1); }
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); go(cur - 1); }
    });
    let wheelLock = false;
    window.addEventListener('wheel', (e) => {
      if (wheelLock || Math.abs(e.deltaY) < 24) return;
      wheelLock = true; setTimeout(() => wheelLock = false, 600);
      go(cur + (e.deltaY > 0 ? 1 : -1));
    }, { passive: true });
    document.getElementById('prev')!.addEventListener('click', () => go(cur - 1));
    document.getElementById('next')!.addEventListener('click', () => go(cur + 1));

    // 主题切换
    document.getElementById('theme-btn')!.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('wcad-theme', next);
    });

    render();
  </script>
</body>
</html>
