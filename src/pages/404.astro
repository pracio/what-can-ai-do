---
const B = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
---
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 · What Can AI Do?</title>
    <meta name="robots" content="noindex" />
    <style>
      :root { --bg: #08080c; --ink: #fff; --ink-80: rgba(255,255,255,.8); --card: rgba(255,255,255,.05); --card-border: rgba(255,255,255,.1); }
      [data-theme="light"] { --bg: #f7f7fa; --ink: #1a1a22; --ink-80: rgba(26,26,34,.78); --card: rgba(255,255,255,.72); --card-border: rgba(26,26,34,.1); }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--ink); font-family: system-ui, -apple-system, sans-serif; transition: background .3s, color .3s; }
      .wrap { max-width: 560px; margin: 0 auto; padding: 64px 20px; text-align: center; }
      .code { font-size: 64px; font-weight: 800; opacity: .15; letter-spacing: .05em; }
      h1 { font-size: 20px; margin: 8px 0 12px; }
      p { font-size: 14px; line-height: 1.8; color: var(--ink-80); margin: 0 0 24px; }
      a { display: inline-block; margin: 4px 6px; padding: 10px 18px; border-radius: 999px;
          border: 1px solid var(--card-border); background: var(--card); color: var(--ink-80);
          text-decoration: none; font-size: 14px; }
    </style>
    <script is:inline>
      (function () {
        var saved = localStorage.getItem('wcad-theme');
        var sys = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = saved || sys;
      })();
    </script>
  </head>
  <body>
    <div class="wrap">
      <div class="code">404</div>
      <h1>这一页不存在</h1>
      <p>链接可能写错了，或者案例还没翻成这个语言。</p>
      <a href={`${B}/zh-Hans/`}>简体中文</a>
      <a href={`${B}/zh-Hant/`}>繁體中文</a>
      <a href={`${B}/en/`}>English</a>
    </div>
  </body>
</html>
