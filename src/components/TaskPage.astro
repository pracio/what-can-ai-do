---
import { render } from 'astro:content';

// 多语言详情页模板。i18n 文案集中在 UI 常量里，三语壳各传一份
export type TaskPageUI = {
  backLabel: string;
  homeHref: string;
  themeBtn: string;
  themeAria: string;
  footnote: string;
  lastTested: string;
  pendingBadge: string;
  htmlLang: string;
  shareLabel: string;
  shareOk: string;
};

const TRIO_SLUGS = new Set(['restore-old-photo', 'summarize-doc', 'tutoring-kids', 'agent-research-report', 'spot-scam']);
const { task, ui, prev, next } = Astro.props;
const { Content } = await render(task);
---
<html lang={ui.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{task.data.title} — What Can AI Do?</title>
    <meta name="description" content={task.data.tagline} />
    <link rel="canonical" href={`https://what-can-ai-do.pages.dev${Astro.url.pathname}`} />
    {TRIO_SLUGS.has(task.data.task_id) && (
      <>
        <link rel="alternate" hreflang="zh-Hans" href={`https://what-can-ai-do.pages.dev/zh-Hans/tasks/${task.data.task_id}/`} />
        <link rel="alternate" hreflang="zh-Hant" href={`https://what-can-ai-do.pages.dev/zh-Hant/tasks/${task.data.task_id}/`} />
        <link rel="alternate" hreflang="en" href={`https://what-can-ai-do.pages.dev/en/tasks/${task.data.task_id}/`} />
      </>
    )}
    <meta property="og:type" content="article" />
    <meta property="og:title" content={task.data.title} />
    <meta property="og:description" content={task.data.tagline} />
    <meta property="og:url" content={`https://what-can-ai-do.pages.dev${Astro.url.pathname}`} />
    <meta property="og:site_name" content="What Can AI Do?" />
    <meta name="twitter:card" content="summary" />
    <style is:global>
      :root {
        --bg: #08080c; --ink: #f2f2f7; --ink-dim: rgba(242,242,247,.65); --ink-faint: rgba(242,242,247,.45);
        --card: rgba(255,255,255,.055); --card-border: rgba(255,255,255,.12);
        --line: rgba(255,255,255,.08); --code-bg: rgba(255,255,255,.09);
        --accent: #fbbf24; --accent-soft: rgba(251,191,36,.12);
      }
      [data-theme="light"] {
        --bg: #f7f7fa; --ink: #1a1a22; --ink-dim: rgba(26,26,34,.68); --ink-faint: rgba(26,26,34,.45);
        --card: rgba(255,255,255,.72); --card-border: rgba(26,26,34,.1);
        --line: rgba(26,26,34,.09); --code-bg: rgba(26,26,34,.06);
        --accent-soft: rgba(251,191,36,.16);
      }
      * { box-sizing: border-box; }
      body { max-width: 680px; margin: 0 auto; padding: 20px; font-family: -apple-system, system-ui, 'PingFang SC', 'Microsoft YaHei', sans-serif; line-height: 1.75; color: var(--ink); background: var(--bg); transition: background .3s, color .3s; }
      .topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
      a.back { font-size: 0.9em; text-decoration: none; color: var(--ink-dim); }
      a.back:hover { color: var(--ink); }
      .theme-btn { border: 1px solid var(--card-border); background: var(--card); color: var(--ink-dim);
                   border-radius: 999px; padding: 3px 12px; font-size: 12px; cursor: pointer; font-family: inherit; }
      table { border-collapse: collapse; width: 100%; margin: 12px 0; }
      th, td { border: 1px solid var(--line); padding: 6px 10px; text-align: left; font-size: 0.92em; }
      th { background: var(--card); }
      blockquote { border-left: 4px solid var(--accent); background: var(--accent-soft); margin: 10px 0; padding: 10px 14px; border-radius: 4px; }
      blockquote p { margin: 0; }
      h1 { font-size: 1.5em; } h2 { font-size: 1.2em; margin-top: 1.6em; border-bottom: 1px solid var(--line); padding-bottom: 4px; }
      h3 { font-size: 1.05em; }
      code { background: var(--code-bg); padding: 1px 5px; border-radius: 3px; font-size: 0.9em; }
      .badge { background: var(--accent-soft); padding: 2px 8px; border-radius: 10px; font-size: 0.85em; }
      hr { margin-top: 3em; border: none; border-top: 1px solid var(--line); }
      .footnote { font-size: 0.85em; color: var(--ink-faint); }
      a { color: #93c5fd; }
      .risk-bar { display: flex; gap: 10px; align-items: flex-start; margin: 22px 0 14px; padding: 12px 14px;
                  border: 1px solid rgba(251,113,133,.4); border-radius: 12px;
                  background: rgba(251,113,133,.08); color: #fb7185; font-size: .88em; line-height: 1.7; }
      .risk-bar svg { flex-shrink: 0; margin-top: 3px; }
      .troubleshoot { margin: 0 0 22px; border: 1px solid var(--card-border); border-radius: 12px; background: var(--card); }
      .troubleshoot summary { cursor: pointer; padding: 12px 14px; font-weight: 600; font-size: .92em;
                             list-style: none; display: flex; justify-content: space-between; align-items: center; }
      .troubleshoot summary::-webkit-details-marker { display: none; }
      .troubleshoot .ts-arrow { transition: transform .2s; opacity: .5; }
      .troubleshoot[open] .ts-arrow { transform: rotate(180deg); }
      .troubleshoot .ts-lead { margin: 0 14px 8px; font-size: .85em; opacity: .6; }
      .troubleshoot ul { margin: 0; padding: 0 14px 14px 32px; font-size: .88em; line-height: 1.9; opacity: .85; }
      .pn-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 0 0 22px; }
      .pn { display: flex; flex-direction: column; gap: 3px; padding: 12px 14px; border: 1px solid var(--card-border);
            border-radius: 12px; text-decoration: none; background: var(--card); min-height: 44px; }
      .pn.next { text-align: right; }
      .pn-label { font-size: .72em; opacity: .5; }
      .pn-title { font-size: .9em; font-weight: 600; color: var(--ink); }
      /* 提示词一键复制卡 */
      article blockquote { position: relative; margin: 14px 0; padding: 14px 16px; border-radius: 12px;
            border: 1.5px solid var(--accent, #fbbf24); background: var(--card); cursor: pointer;
            -webkit-user-select: none; user-select: none; transition: transform .12s; }
      article blockquote:active { transform: scale(.985); }
      article blockquote::before { content: attr(data-copy-hint); position: absolute; top: -9px; right: 12px;
            font-size: .68em; padding: 2px 9px; border-radius: 999px; white-space: nowrap;
            background: var(--accent, #fbbf24); color: #0a0a0f; font-weight: 700; }
      article blockquote.copied::before { content: attr(data-copied-text); }
      article blockquote p { margin: 0; -webkit-user-select: text; user-select: text; }
    </style>
    <script is:inline>
      (function () {
        var saved = localStorage.getItem('wcad-theme');
        var sys = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = saved || sys;
      })();
      (function () {
        var COPY_HINT = window.__COPY.hint, COPY_OK = window.__COPY.ok;
      // 提示词一键复制
      document.querySelectorAll('article blockquote').forEach(function (bq) {
        bq.setAttribute('data-copy-hint', COPY_HINT);
        bq.setAttribute('data-copied-text', COPY_OK);
        bq.addEventListener('click', function () {
          var text = bq.innerText.replace(COPY_HINT, '').replace(COPY_OK, '').trim();
          function done() { bq.classList.add('copied'); setTimeout(function () { bq.classList.remove('copied'); }, 1800); }
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(done);
          } else {
            var ta = document.createElement('textarea');
            ta.value = text; document.body.appendChild(ta); ta.select();
            document.execCommand('copy'); document.body.removeChild(ta); done();
          }
        });
      });
      })();
    </script>
    <meta property="og:image" content="https://what-can-ai-do.pages.dev/og-card.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://what-can-ai-do.pages.dev/og-card.jpg" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>
  <body>
    <div class="topbar">
      <a class="back" href={ui.homeHref}>{ui.backLabel}</a>
      <button class="theme-btn" id="theme-btn" aria-label={ui.themeAria}>{ui.themeBtn}</button>
    </div>
    <div class="headline">
      <p class="tagline">{task.data.tagline}</p>
      <button class="share-btn" id="share-btn" data-ok={ui.shareOk} data-copy-hint={ui.promptCopyHint} data-copy-ok={ui.promptCopyOk}>{ui.shareLabel}</button>
    </div>
    <article>
      <Content />
    </article>
    <div class="risk-bar">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
      <span>{ui.riskBar}</span>
    </div>
    <details class="troubleshoot">
      <summary>{ui.troubleshootTitle}<span class="ts-arrow" aria-hidden="true">▾</span></summary>
      <p class="ts-lead">{ui.troubleshootLead}</p>
      <ul>
        {ui.troubleshootItems.map((item) => <li set:html={item} />)}
      </ul>
    </details>
    <nav class="pn-nav" aria-label="案例翻页">
      <a class="pn prev" href={`../${prev.id.replace(/\.md$/, '')}/`}>
        <span class="pn-label">{ui.prevLabel}</span>
        <span class="pn-title">{prev.data.title ?? prev.id}</span>
      </a>
      <a class="pn next" href={`../${next.id.replace(/\.md$/, '')}/`}>
        <span class="pn-label">{ui.nextLabel}</span>
        <span class="pn-title">{next.data.title ?? next.id}</span>
      </a>
    </nav>
    <hr />
    <p class="footnote">
      {ui.footnote}
      {task.data.last_tested && task.data.last_tested !== 'pending' && (
        <span>{ui.lastTested}{task.data.last_tested}</span>
      )}
      {(!task.data.last_tested || task.data.last_tested === 'pending') && (
        <span class="badge">{ui.pendingBadge}</span>
      )}
    </p>
    <style>
      .headline { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin: 4px 0 14px; }
      .tagline { font-size: 1.05em; font-weight: 600; color: var(--ink); opacity: .85; margin: 0; flex: 1; }
      .share-btn { flex-shrink: 0; border: 1px solid var(--card-border); background: var(--card); color: var(--ink-dim);
                   border-radius: 999px; padding: 7px 14px; font-size: .85em; cursor: pointer; font-family: inherit; }
      .share-btn:active { transform: scale(.97); }
    </style>
    <script is:inline>
      (function () {
        var btn = document.getElementById('share-btn');
        window.__COPY = { hint: btn.dataset.copyHint, ok: btn.dataset.copyOk };
        var OK = btn.dataset.ok;
        function done() { var t = btn.textContent; btn.textContent = OK; setTimeout(function(){ btn.textContent = t; }, 1800); }
        btn.addEventListener('click', function () {
          var title = document.title;
          var url = location.href;
          if (navigator.share) {
            navigator.share({ title: title, url: url }).then(done).catch(function () {});
          } else if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(done);
          } else {
            var ta = document.createElement('textarea');
            ta.value = url; document.body.appendChild(ta); ta.select();
            document.execCommand('copy'); document.body.removeChild(ta); done();
          }
        });
      })();
      (function () {
        var COPY_HINT = window.__COPY.hint, COPY_OK = window.__COPY.ok;
      // 提示词一键复制
      document.querySelectorAll('article blockquote').forEach(function (bq) {
        bq.setAttribute('data-copy-hint', COPY_HINT);
        bq.setAttribute('data-copied-text', COPY_OK);
        bq.addEventListener('click', function () {
          var text = bq.innerText.replace(COPY_HINT, '').replace(COPY_OK, '').trim();
          function done() { bq.classList.add('copied'); setTimeout(function () { bq.classList.remove('copied'); }, 1800); }
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(done);
          } else {
            var ta = document.createElement('textarea');
            ta.value = text; document.body.appendChild(ta); ta.select();
            document.execCommand('copy'); document.body.removeChild(ta); done();
          }
        });
      });
      })();
    </script>
    <script is:inline>
      document.getElementById('theme-btn').addEventListener('click', function () {
        var cur = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = cur;
        localStorage.setItem('wcad-theme', cur);
      });
    </script>
  </body>
</html>
