---
import { render } from 'astro:content';

// 多语言详情页模板。i18n 文案集中在 UI 常量里，三语壳各传一份
export type TaskPageUI = {
  backLabel: string;
  homeHref: string;
  themeBtn: string;
  themeAria: string;
  footnote: string;
  lastTested: string;
  pendingBadge: string;
  htmlLang: string;
  shareLabel: string;
  shareOk: string;
};

const TRIO_SLUGS = new Set(['restore-old-photo', 'summarize-doc', 'tutoring-kids', 'agent-research-report', 'spot-scam']);
const { task, ui } = Astro.props;
const { Content } = await render(task);
---
<html lang={ui.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{task.data.title} — What Can AI Do?</title>
    <meta name="description" content={task.data.tagline} />
    <link rel="canonical" href={`https://what-can-ai-do.pages.dev${Astro.url.pathname}`} />
    {TRIO_SLUGS.has(task.data.task_id) && (
      <>
        <link rel="alternate" hreflang="zh-Hans" href={`https://what-can-ai-do.pages.dev/zh-Hans/tasks/${task.data.task_id}/`} />
        <link rel="alternate" hreflang="zh-Hant" href={`https://what-can-ai-do.pages.dev/zh-Hant/tasks/${task.data.task_id}/`} />
        <link rel="alternate" hreflang="en" href={`https://what-can-ai-do.pages.dev/en/tasks/${task.data.task_id}/`} />
      </>
    )}
    <meta property="og:type" content="article" />
    <meta property="og:title" content={task.data.title} />
    <meta property="og:description" content={task.data.tagline} />
    <meta property="og:url" content={`https://what-can-ai-do.pages.dev${Astro.url.pathname}`} />
    <meta property="og:site_name" content="What Can AI Do?" />
    <meta name="twitter:card" content="summary" />
    <style is:global>
      :root {
        --bg: #08080c; --ink: #f2f2f7; --ink-dim: rgba(242,242,247,.65); --ink-faint: rgba(242,242,247,.45);
        --card: rgba(255,255,255,.055); --card-border: rgba(255,255,255,.12);
        --line: rgba(255,255,255,.08); --code-bg: rgba(255,255,255,.09);
        --accent: #fbbf24; --accent-soft: rgba(251,191,36,.12);
      }
      [data-theme="light"] {
        --bg: #f7f7fa; --ink: #1a1a22; --ink-dim: rgba(26,26,34,.68); --ink-faint: rgba(26,26,34,.45);
        --card: rgba(255,255,255,.72); --card-border: rgba(26,26,34,.1);
        --line: rgba(26,26,34,.09); --code-bg: rgba(26,26,34,.06);
        --accent-soft: rgba(251,191,36,.16);
      }
      * { box-sizing: border-box; }
      body { max-width: 680px; margin: 0 auto; padding: 20px; font-family: -apple-system, system-ui, 'PingFang SC', 'Microsoft YaHei', sans-serif; line-height: 1.75; color: var(--ink); background: var(--bg); transition: background .3s, color .3s; }
      .topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
      a.back { font-size: 0.9em; text-decoration: none; color: var(--ink-dim); }
      a.back:hover { color: var(--ink); }
      .theme-btn { border: 1px solid var(--card-border); background: var(--card); color: var(--ink-dim);
                   border-radius: 999px; padding: 3px 12px; font-size: 12px; cursor: pointer; font-family: inherit; }
      table { border-collapse: collapse; width: 100%; margin: 12px 0; }
      th, td { border: 1px solid var(--line); padding: 6px 10px; text-align: left; font-size: 0.92em; }
      th { background: var(--card); }
      blockquote { border-left: 4px solid var(--accent); background: var(--accent-soft); margin: 10px 0; padding: 10px 14px; border-radius: 4px; }
      blockquote p { margin: 0; }
      h1 { font-size: 1.5em; } h2 { font-size: 1.2em; margin-top: 1.6em; border-bottom: 1px solid var(--line); padding-bottom: 4px; }
      h3 { font-size: 1.05em; }
      code { background: var(--code-bg); padding: 1px 5px; border-radius: 3px; font-size: 0.9em; }
      .badge { background: var(--accent-soft); padding: 2px 8px; border-radius: 10px; font-size: 0.85em; }
      hr { margin-top: 3em; border: none; border-top: 1px solid var(--line); }
      .footnote { font-size: 0.85em; color: var(--ink-faint); }
      a { color: #93c5fd; }
    </style>
    <script is:inline>
      (function () {
        var saved = localStorage.getItem('wcad-theme');
        var sys = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = saved || sys;
      })();
    </script>
    <meta property="og:image" content="https://what-can-ai-do.pages.dev/og-card.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://what-can-ai-do.pages.dev/og-card.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>
  <body>
    <div class="topbar">
      <a class="back" href={ui.homeHref}>{ui.backLabel}</a>
      <button class="theme-btn" id="theme-btn" aria-label={ui.themeAria}>{ui.themeBtn}</button>
    </div>
    <div class="headline">
      <p class="tagline">{task.data.tagline}</p>
      <button class="share-btn" id="share-btn" data-ok={ui.shareOk}>{ui.shareLabel}</button>
    </div>
    <article>
      <Content />
    </article>
    <hr />
    <p class="footnote">
      {ui.footnote}
      {task.data.last_tested && task.data.last_tested !== 'pending' && (
        <span>{ui.lastTested}{task.data.last_tested}</span>
      )}
      {(!task.data.last_tested || task.data.last_tested === 'pending') && (
        <span class="badge">{ui.pendingBadge}</span>
      )}
    </p>
    <style>
      .headline { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin: 4px 0 14px; }
      .tagline { font-size: 1.05em; font-weight: 600; color: var(--ink); opacity: .85; margin: 0; flex: 1; }
      .share-btn { flex-shrink: 0; border: 1px solid var(--card-border); background: var(--card); color: var(--ink-dim);
                   border-radius: 999px; padding: 7px 14px; font-size: .85em; cursor: pointer; font-family: inherit; }
      .share-btn:active { transform: scale(.97); }
    </style>
    <script is:inline>
      (function () {
        var btn = document.getElementById('share-btn');
        var OK = btn.dataset.ok;
        function done() { var t = btn.textContent; btn.textContent = OK; setTimeout(function(){ btn.textContent = t; }, 1800); }
        btn.addEventListener('click', function () {
          var title = document.title;
          var url = location.href;
          if (navigator.share) {
            navigator.share({ title: title, url: url }).then(done).catch(function () {});
          } else if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(done);
          } else {
            var ta = document.createElement('textarea');
            ta.value = url; document.body.appendChild(ta); ta.select();
            document.execCommand('copy'); document.body.removeChild(ta); done();
          }
        });
      })();
    </script>
    <script is:inline>
      document.getElementById('theme-btn').addEventListener('click', function () {
        var cur = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = cur;
        localStorage.setItem('wcad-theme', cur);
      });
    </script>
  </body>
</html>
